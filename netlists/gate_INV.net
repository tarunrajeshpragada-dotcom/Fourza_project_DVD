* INV gate, widths varied per corner
.INCLUDE /home/tarun/dvd_project/models/16nm_HP.pm
.OPTIONS GMIN=1e-18 ABSTOL=1e-18 RELTOL=1e-6 VNTOL=1e-9

mp out a vdd vdd pmos W=1.6e-08 L=1.6e-08 AD=5.12e-16 AS=5.12e-16
mn out a 0 0 nmos W=1.6e-08 L=1.6e-08 AD=5.12e-16 AS=5.12e-16
Vdd_src vdd 0 0
Va a 0 0

.control
altermod @nmos[vth0]=0.43745504
